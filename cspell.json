{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "language": "en",
  "dictionaries": [
    "bash",
    "git",
    "markdown",
    "node",
    "npm",
    "shell",
    "software-terms"
  ],
  "useGitignore": true,
  "enableGlobDot": true,
  "words": [
    "arthurc0102",
    "dotagents",
    "dotfiles",
    "herdr",
    "herdrdev",
    "lsp",
    "mattpocock",
    "pocock",
    "prek",
    "shuorenhua",
    "superproject",
    "toplevel",
    "uvx",
    "venv"
  ],
  "overrides": [
    {
      "filename": ".claude-plugin/marketplace.json",
      "ignoreRegExpList": ["/\"(?:name|repo)\":\\s*\"[^\"]*\"/g"]
    },
    {
      "filename": "README.md",
      "ignoreRegExpList": [
        "/\\[[^\\]]*\\]\\(https:\\/\\/github\\.com\\/[^)]*\\)/g"
      ]
    }
  ]
}
